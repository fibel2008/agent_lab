# =================================================================
# Emibot 在线模型配置模板
# 使用方法：复制本文件为 .env 并填写你的真实 API Key 即可
# =================================================================

# 模型服务商 API 密钥（必填，切换在线模式前必须配置）
ASSISTANT_API_KEY=your_api_key_here

# 模型服务商接口端点（选填，默认 https://api.openai.com/v1）
# 支持任意 OpenAI 兼容协议服务商，如：
# - DeepSeek: https://api.deepseek.com/v1
# - SiliconFlow (硅基流动): https://api.siliconflow.cn/v1
# - Moonshot (Kimi): https://api.moonshot.cn/v1
# - Zhipu (智谱 GLM): https://open.bigmodel.cn/api/paas/v4
# - OpenAI 官方: https://api.openai.com/v1
ASSISTANT_BASE_URL=https://api.openai.com/v1

# 模型名称（选填，默认 gpt-4o-mini）
# 例如: deepseek-chat, gpt-4o-mini, glm-4-flash, Qwen/Qwen2.5-7B-Instruct 等
ASSISTANT_MODEL=gpt-4o-mini

# 请求超时时间（秒，选填，默认 60）
ASSISTANT_REQUEST_TIMEOUT=60

# 服务绑定地址（选填，仅允许 127.0.0.1、localhost、::1 环回地址，默认 127.0.0.1）
ASSISTANT_HOST=127.0.0.1

# 服务监听端口（选填，默认 8000）
ASSISTANT_PORT=8000

# 启动时是否自动打开浏览器（1/true 为开启，0/false 为关闭，默认关闭）
ASSISTANT_OPEN_BROWSER=0
